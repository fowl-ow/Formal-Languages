.class public Fibonacci
.super java/lang/Object 

.method public <init>()V 
    aload 0
    invokenonvirtual java/lang/Object/<init>()V
    return
.end method

.method public static main([Ljava/lang/String;)V
    .limit locals 2
    .limit stack  10

    ; args is in local 0
    aload_0        
    ldc 0
    aaload              ; load args[0]

    invokestatic java/lang/Integer/parseInt(Ljava/lang/String;)I
    ; stack: [ n ]

    getstatic     java/lang/System/out Ljava/io/PrintStream;
    swap                 ; stack: [ out, n ]

    invokestatic  Fibonacci/fibonacci(I)I
    ; stack: [ out, fib(n) ]

    invokevirtual java/io/PrintStream/println(I)V
    ; prints fib(n)

    return
.end method

.method public static fibonacci(I)I
    .limit locals 1
    .limit stack  3
    iload   0
    ldc     1
    if_icmple end

    iload 0
    ldc   1
    isub
    invokestatic  Fibonacci/fibonacci(I)I
    iload 0
    ldc   2
    isub
    invokestatic  Fibonacci/fibonacci(I)I
    iadd
    ireturn
end:
    iload   0
    ireturn
.end method
